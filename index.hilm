import time

class MienKyNiem:
    def __init__(self, ten_nhan_vat):
        self.ten = ten_nhan_vat
        self.trang_thai = "Người Thương"
        self.ky_niem_chung = [
            "Những tin nhắn chúc ngủ ngon mỗi đêm",
            "Cùng nhau dạo phố dưới mưa Sài Gòn",
            "Lời hứa hẹn về tương lai ngày sau"
        ]
        self.khoang_cach = 0.0 # Khoảng cách tâm hồn giữa hai người

    def hien_trang(self):
        print(f"\n--- Trạng thái của [{self.ten}] ---")
        print(f"Trạng thái hiện tại: {self.trang_thai}")
        print(f"Khoảng cách: {self.khoang_cach} km")
        print("Ký ức còn lưu giữ:")
        if self.ky_niem_chung:
            for i, kn in enumerate(self.ky_niem_chung, 1):
                print(f"  {i}. {kn}")
        else:
            print("  (Bộ nhớ trống rỗng, không còn gì sót lại...)")

    def thoi_gian_troi_qua(self, so_thang):
        print(f"\n⏳ Thời gian trôi qua {so_thang} tháng xa cách...")
        self.khoang_cach += so_thang * 15.5
        
        if self.khoang_cach >= 50.0 and self.trang_thai == "Người Thương":
            self.trang_thai = "Người Lạ"
            print(f"⚠️ Cảnh báo: Khoảng cách quá lớn! [{self.ten}] dần phai nhạt ký ức.")

    def tro_thanh_nguoi_dung(self):
        print(f"\n💔 QUYẾT ĐỊNH BUÔNG TAY...")
        self.trang_thai = "Người Dưng"
        self.khoang_cach = 999.9
        self.ky_niem_chung.clear()
        print(f"[{self.ten}] chính thức bước qua đời nhau như hai đường thẳng song song.")
        print("Tất cả ký ức đã bị xóa sạch (Memory Cleared).")

# --- Kịch bản chạy chương trình ---
if __name__ == "__main__":
    # Khởi tạo nhân vật trong bài hát
    nhan_vat = MienKyN/Vat = MienKyNiem("Jack & Người Ấy") # Giả lập chung câu chuyện
    
    # 1. Giai đoạn mặn nồng ban đầu
    nhan_vat.hien_trang()
    time.sleep(1)
    
    # 2. Giai đoạn phai nhạt dần theo thời gian
    nhan_vat.thoi_gian_tro_thanh = 3 # Trôi qua 3 tháng xa cách
    nhan_vat.thoi_gian_troi_qua(3)
    nhan_vat.hien_trang()
    time.sleep(1)
    
    # 3. Kết cục thành người dưng
    nhan_vat.tro_thanh_nguoi_dung()
    nhan_vat.hien_trang()
    
    print("\n🎵 Kết thúc bài hát: 'Người dưng ngược lối, chúc nhau bình yên...'")
